# Conexion a PostgreSQL 14+
BD_HOST=127.0.0.1
BD_PUERTO=5432
BD_NOMBRE=servitotal
BD_USUARIO=postgres
BD_CONTRASENA=postgres
BD_MAX_CONEXIONES=10

# Semilla del generador de datos de prueba. Fijarla hace la siembra reproducible.
SEMILLA_DATOS=20260913

# Servidor HTTP
PUERTO=3000

# Firma de los JWT. Minimo 32 caracteres.
# Genere uno propio con: openssl rand -base64 48
JWT_SECRETO=cambie-esta-clave-por-una-generada-al-azar-de-48-bytes
JWT_EMISOR=servitotal
JWT_AUDIENCIA=servitotal-api
JWT_MINUTOS_ACCESO=15
JWT_HORAS_REFRESCO_PANEL=12
JWT_DIAS_REFRESCO_DISPOSITIVO=30

# Intentos fallidos consecutivos tras los cuales la cuenta queda bloqueada
SEGURIDAD_INTENTOS_PARA_BLOQUEO=5

# Nivel de bitacora: depuracion | informacion | advertencia | error
NIVEL_BITACORA=informacion
