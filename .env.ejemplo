# Variables de entorno de ServiTotal.
#
# Los nombres del pliego (DATABASE_*, JWT_SECRET, PORT) y los propios
# (BD_*, JWT_SECRETO, PUERTO) funcionan los dos. Si define ambos, manda el
# del pliego. Aqui se usan los del pliego.
#
# Conexion a PostgreSQL 14+
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=servitotal
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
BD_MAX_CONEXIONES=10

# Semilla del generador de datos de prueba. Fijarla hace la siembra reproducible.
SEMILLA_DATOS=20260913

# Servidor HTTP
PORT=3000

# Firma de los JWT. Minimo 32 caracteres.
# Genere uno propio con: openssl rand -base64 48
JWT_SECRET=cambie-esta-clave-por-una-generada-al-azar-de-48-bytes
JWT_EMISOR=servitotal
JWT_AUDIENCIA=servitotal-api
JWT_MINUTOS_ACCESO=15
JWT_HORAS_REFRESCO_PANEL=12
JWT_DIAS_REFRESCO_DISPOSITIVO=30

# Intentos fallidos consecutivos tras los cuales la cuenta queda bloqueada
SEGURIDAD_INTENTOS_PARA_BLOQUEO=5

# Almacenamiento de objetos: donde viven los archivos de evidencia.
# Los binarios NUNCA van en la base de datos; aqui solo ruta, huella y metadatos.
# En desarrollo, una carpeta del propio proyecto (esta en .gitignore).
# En produccion, algo como /var/lib/servitotal/evidencias, con permisos para
# el usuario que corre el servicio.
ALMACEN_OBJETOS_RAIZ=./datos/evidencias

# Nivel de bitacora: depuracion | informacion | advertencia | error
NIVEL_BITACORA=informacion
