{
  "expo": {
    "name": "ServiTotal",
    "slug": "servitotal",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "ni.com.unicomer.servitotal",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_NETWORK_STATE"]
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "ni.com.unicomer.servitotal" },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      ["expo-image-picker", {
        "cameraPermission": "ServiTotal usa la camara para la evidencia de las ordenes de servicio."
      }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "ServiTotal adjunta la ubicacion a la evidencia tomada en el domicilio del cliente."
      }]
    ]
  }
}
