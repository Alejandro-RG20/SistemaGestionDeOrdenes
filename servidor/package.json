{
  "name": "@servitotal/servidor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "construir": "tsc -b",
    "iniciar": "node dist/servidor.js",
    "desarrollo": "tsx watch src/servidor.ts",
    "migrar": "tsx src/infraestructura/migraciones/cli.ts aplicar",
    "migrar:estado": "tsx src/infraestructura/migraciones/cli.ts estado",
    "sembrar": "tsx src/infraestructura/semillas/cli.ts",
    "prueba": "vitest run",
    "prueba:unidad": "vitest run pruebas/unidad"
  },
  "dependencies": {
    "@servitotal/compartido": "*",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2"
  }
}
